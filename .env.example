# CPU: one multi-platform tag for Intel/AMD x86-64 and ARM64.
VLM_CPU_IMAGE=zgzdocker/vlm-ws:cpu
# NVIDIA CUDA: x86-64 only with the current pinned PyTorch base.
VLM_CUDA_IMAGE=zgzdocker/vlm-ws:cuda12.1
# Optional local-build overrides (host Linux distro does not affect these).
CPU_BASE_IMAGE=python:3.10-slim-bookworm
CUDA_BASE_IMAGE=pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime
# scripts/dev.sh synchronizes these two IDs with the invoking Linux user.
LOCAL_UID=1000
LOCAL_GID=1000
TZ=Asia/Shanghai
SHM_SIZE=2gb
BIND_ADDRESS=127.0.0.1
JUPYTER_PORT=8888
TENSORBOARD_PORT=6006
WEB_PORT=8000

# Optional personal tools; not needed to train, evaluate, or use Dev Containers.
INSTALL_OPTIONAL_SHELL_TOOLS=0
# Enable mounts with the shell prefix: VLM_HOST_TOOLS=1 ./scripts/dev.sh ...
# HOST_OPENCODE_CONFIG=${HOME}/.config/opencode
# HOST_OPENCODE_AUTH=${HOME}/.local/share/opencode/auth.json
# HOST_AGENTS_DIR=${HOME}/.agents
