# Managed zsh bootstrap for the VLM workspace container.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="af-magic"
plugins=(git)

zstyle ':omz:update' mode disabled

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
else
    # Provide af-magic's appearance without requiring optional shell tools.
    _vlm_git_prompt_info() {
        local branch git_status dirty=''
        branch="$(command git symbolic-ref --quiet --short HEAD 2>/dev/null)" ||
            branch="$(command git rev-parse --short HEAD 2>/dev/null)" || return 0
        git_status="$(GIT_OPTIONAL_LOCKS=0 command git status --porcelain --ignore-submodules=dirty 2>/dev/null)" || git_status=''
        # Branch names are prompt data; escape zsh's percent sequences.
        branch="${branch//\%/%%}"
        [[ -n "$git_status" ]] && dirty='%F{214}*'
        print -rn -- " %F{75}(%F{78}${branch}${dirty}%F{75})%f"
    }

    setopt PROMPT_SUBST
    PROMPT='%F{237}${(l.$COLUMNS..-.)}%f
%F{32}%~$(_vlm_git_prompt_info) %F{105}%(!.#.»)%f '
fi

[ -f "$HOME/env_setup.zsh" ] && source "$HOME/env_setup.zsh"
[ -f "$HOME/.claude_env" ] && source "$HOME/.claude_env"

# <<< vlm-ws managed zshrc >>>
